<Window x:Class="CursorTranslate.TooltipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="-2000" Top="-2000">
    <Border Background="#F01B1E25" CornerRadius="8" Padding="12,8" MaxWidth="420" Margin="8"
        BorderBrush="#4F8CFF" BorderThickness="3,0,0,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TranslationText" Foreground="White" FontSize="15" TextWrapping="Wrap"/>
            <TextBlock x:Name="OriginalText" Foreground="#AAAAAA" FontSize="11"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</Window>