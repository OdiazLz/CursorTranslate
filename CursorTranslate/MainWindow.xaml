<Window x:Class="CursorTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cursor Translate" Width="380" SizeToContent="Height"
        Icon="Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#16181D"/>
        <SolidColorBrush x:Key="CardBrush" Color="#20232B"/>
        <SolidColorBrush x:Key="LineBrush" Color="#2E323C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8EAED"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8B919E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF"/>

        <!-- Toggle switch -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="22"
                                    CornerRadius="11" Background="#3A3F4B">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox inner button -->
        <Style x:Key="ComboToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="#2A2E37" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                  Data="M0,0 L5,5 L10,0" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggleButton}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                              Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#2A2E37" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Box" Background="Transparent" CornerRadius="6" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#353A45"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimize / close buttons -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2E323C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="14" Margin="12"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <StackPanel>
            <!-- Title bar -->
            <Grid Height="52" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="28" Height="28" CornerRadius="8">
                        <Image Source="Assets/app.ico" Width="28" Height="28"/>
                    </Border>
                    <TextBlock Text="Cursor Translate" Foreground="{StaticResource TextBrush}"
                               FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource WindowButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Toggles -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="18,4,18,0">
                <StackPanel>
                    <CheckBox x:Name="EnabledToggle" Style="{StaticResource ToggleSwitch}"
                              Content="Enabled" IsChecked="True"/>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12"/>
                    <CheckBox x:Name="CtrlOnlyToggle" Style="{StaticResource ToggleSwitch}"
                              Content="Only while holding Ctrl" IsChecked="False"/>
                </StackPanel>
            </Border>

            <!-- Languages -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="18,12,18,0">
                <StackPanel>
                    <TextBlock Text="TRANSLATE" Style="{StaticResource SectionLabel}"/>
                    <ComboBox x:Name="ModeSelector" SelectedIndex="1" Margin="0,0,0,14">
                        <ComboBoxItem Content="Single word" Tag="word"/>
                        <ComboBoxItem Content="Whole sentence" Tag="sentence"/>
                        <ComboBoxItem Content="Whole line" Tag="line"/>
                    </ComboBox>
                    <TextBlock Text="TRANSLATE FROM" Style="{StaticResource SectionLabel}"/>
                    <ComboBox x:Name="SourceLanguage" SelectedIndex="0">
                        <ComboBoxItem Content="English" Tag="en"/>
                        <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                        <ComboBoxItem Content="Spanish" Tag="es"/>
                        <ComboBoxItem Content="Portuguese" Tag="pt"/>
                        <ComboBoxItem Content="French" Tag="fr"/>
                        <ComboBoxItem Content="German" Tag="de"/>
                        <ComboBoxItem Content="Italian" Tag="it"/>
                    </ComboBox>

                    <TextBlock Text="TO" Style="{StaticResource SectionLabel}" Margin="2,14,0,6"/>
                    <ComboBox x:Name="TargetLanguage" SelectedIndex="0">
                        <ComboBoxItem Content="Spanish" Tag="es"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                        <ComboBoxItem Content="Portuguese" Tag="pt"/>
                        <ComboBoxItem Content="French" Tag="fr"/>
                        <ComboBoxItem Content="German" Tag="de"/>
                        <ComboBoxItem Content="Italian" Tag="it"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Status -->
            <Border Background="#1B1E25" CornerRadius="8" Padding="12,10" Margin="18,12,18,18">
                <DockPanel>
                    <Ellipse Width="8" Height="8" Fill="#3DDC84" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="10,0,0,0"
                               Text="Rest the mouse over any text to translate it."/>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>